{
  "id": "nodebb-plugin-rtl-support",
  "name": "NodeBB RTL Support",
  "description": "Right-to-Left (RTL) support and bundled Vazirmatn variable font typography for Persian, Arabic, and Hebrew",
  "url": "https://github.com/Mazafard/nodebb-plugin-rtl-support",
  "library": "./library.js",
  "hooks": [
    { "hook": "filter:parse.post", "method": "parsePost", "priority": 6 },
    { "hook": "filter:parse.raw", "method": "parseRaw", "priority": 6 }
  ],
  "staticDirs": {
    "fonts": "./static/fonts",
    "static": "./static"
  },
  "css": [
    "static/style.css"
  ],
  "scripts": [
    "static/lib/main.js"
  ]
}
